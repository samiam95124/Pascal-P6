!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!                                                                              !
! This is the pc instruction file                                              !
!                                                                              !
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

!
! Declare the main library and protect it from recompiles
!
modulepath "../libs"
exclude "../libs"

!
! Declare packaged libraries
!

!
! Place the built product in the hosts tree
!
linux begin
   amd64_sysv begin
      copy pc "../hosts/linux/x86/bit64/bin/pc"
   end
end
