#!/bin/bash
#
# Test the historic Pascal-P2 port.
#
# Two stages, both through the standard compile/run flow: pcomp (the P2
# compiler) translates p2/roman.pas into P2 intermediate code, then pasint
# (the P2 interpreter) runs that intermediate. The backend option passes
# through to both stages, and pasint's listing is compared against
# p2/roman.cmp.
#
# testp2 [--pgen|--pint|--pmach|--cmach|--package]
#
option=$1
if [ -z "$option" ]; then option="--pgen"; fi
if [ -n "$REGRESS_OUT" ]; then tmpd="$REGRESS_OUT/"; else tmpd=""; fi
ob() { if [ -n "$REGRESS_OUT" ]; then echo "$REGRESS_OUT/$(basename "$1")"; else echo "$1"; fi; }

#
# Translate roman.pas to P2 intermediate with the P2 compiler: the source
# arrives on input, the intermediate filename is the program argument.
#
compile --out="$REGRESS_OUT" --list- $option p2/pcomp || exit 1
run --nolist $option --args="$(ob p2/roman).p2" --in=p2/roman.pas p2/pcomp

#
# Run the intermediate through the P2 interpreter and compare.
#
compile --out="$REGRESS_OUT" --list- --reference- $option p2/pasint || exit 1
run --nolist $option --args="$(ob p2/roman).p2 ${tmpd}temp2" --in=/dev/null p2/pasint

# a missing listing means the run itself failed; do not let an empty
# comparison read as a pass
if [ ! -f $(ob p2/pasint).lst ]; then echo "*** FAIL (no listing)"; exit 1; fi
strip $(ob p2/pasint).lst ${tmpd}tmp1
strip p2/roman.cmp ${tmpd}tmp2
diff -B ${tmpd}tmp1 ${tmpd}tmp2 > $(ob p2/roman).dif
rm -f ${tmpd}tmp1 ${tmpd}tmp2
ls -l $(ob p2/roman).dif | grep ".dif"
if test -s $(ob p2/roman).dif; then echo "*** FAIL"; exit 1
else echo "PASS"; fi
