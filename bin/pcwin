#!/bin/bash
#
# Compile a Pascaline program to a Windows x64 executable.
#
# Execution:
#
# pcwin [<options>] <file>
#
# <file> is the filename without extension. Compiles <file>.pas with the
# Windows x64 calling convention (--windows), producing the intermediate
# <file>.p6, the assembly <file>.s, the object <file>.o and the executable
# <file>.exe. The executable is a Windows PE image: on Windows it runs
# directly, on Linux it runs under Wine (directly if wine binfmt support is
# installed, otherwise via "wine64 ./<file>.exe").
#
# All options are passed through to the compiler.
#
# Requirements:
#
# - The Windows runtime components must be built ("make win64"), which on
#   non-Windows hosts needs the mingw-w64 cross toolchain (Ubuntu package
#   gcc-mingw-w64-x86-64).
# - The Ami I/O models (terminal, graphics, etc.) are not yet available in
#   the Windows build; programs are limited to standard (console) I/O and
#   may not reference the Ami modules.
#

#
# Select the Windows toolchain: native gcc on a Windows host, the mingw-w64
# cross toolchain elsewhere (matches the makefile win64 target).
#
if [ "$OS" = "Windows_NT" ]; then

    wincc=gcc

else

    wincc=x86_64-w64-mingw32-gcc

fi

pcomflags=""
prog=""

for param in "$@"
do

    case "$param" in

        -*) pcomflags="$pcomflags $param" ;;  # pass other options through
        *)  prog="$param" ;;

    esac

done

if [ -z "$prog" ]; then

    echo "*** Error: No compile file specified"
    exit 1

fi

if [ ! -f "$prog.pas" ]; then

    echo "*** Error: Source file $prog.pas does not exist"
    exit 1

fi

if ! command -v "$wincc" > /dev/null; then

    echo "*** Error: Windows toolchain $wincc not found"
    echo "*** On Ubuntu install it with: sudo apt install gcc-mingw-w64-x86-64"
    exit 1

fi

if [ ! -f "$PASCALP6/libs/win64/psystem.a" -o ! -f "$PASCALP6/libs/win64/main.o" ]; then

    echo "*** Error: Windows runtime components not found"
    echo "*** Build them with: make win64"
    exit 1

fi

#
# Compile to intermediate with the Windows calling convention
#
pcom --windows $pcomflags "$prog.pas"
if [ $? -ne 0 ]; then

    echo "*** Error: Compile of $prog.pas failed"
    exit 1

fi

#
# Generate Windows x64 assembly. The windows option must be given on the
# command line; the intermediate carries it only as a validation.
#
pgen "$prog.p6" "$prog.s" --windows+
if [ $? -ne 0 ]; then

    echo "*** Error: Code generation for $prog.p6 failed"
    exit 1

fi

#
# Assemble and link the PE executable
#
$wincc -g3 -o "$prog.o" -c "$prog.s"
if [ $? -ne 0 ]; then

    echo "*** Error: Assembly of $prog.s failed"
    exit 1

fi

$wincc -static -g3 -o "$prog.exe" \
    "$PASCALP6/libs/win64/main.o" "$prog.o" \
    "$PASCALP6/libs/win64/psystem.a" -lm
if [ $? -ne 0 ]; then

    echo "*** Error: Link of $prog.exe failed"
    exit 1

fi

echo "$prog.exe complete"
