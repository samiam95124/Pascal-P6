#!/bin/bash
#
# Run the Pascaline test suite.
#
# The test is a three-unit Pascaline program (pascaline.pas and the modules
# pascaline1/pascaline2); pc discovers and builds the modules from the uses
# chain, so the whole build is one compile. The program takes free form
# arguments (two header filenames and assorted parameters), passed through
# run's --args override, with pascaline.inp as input; the listing is compared
# against pascaline.cmp.
#
# The test directory must be the working directory with bare filenames. For a
# parallel per-model run (REGRESS_OUT set), the inputs are copied into the
# per-model directory and the work happens there, so bare-filename products do
# not collide with other models.
#
# testpascaline [--pgen|--pint|--pmach|--cmach|--package]
#
option=$1
if [ -z "$option" ]; then option="--pgen"; fi

test_path=pascaline_tests
if [ -n "$REGRESS_OUT" ]; then
    mkdir -p "$REGRESS_OUT"
    cp "$test_path"/pascaline2.pas "$test_path"/pascaline1.pas "$test_path"/pascaline.pas \
       "$test_path"/pascaline.inp "$test_path"/pascaline.cmp \
       "$test_path"/headertest1 "$test_path"/headertest2 "$test_path"/readtest.txt "$REGRESS_OUT"/
    test_path="$REGRESS_OUT"
    # the work happens inside the per-model dir with bare filenames; the
    # sub-tools must not re-apply REGRESS_OUT
    unset REGRESS_OUT
fi
cd "$test_path" || { echo "*** testpascaline: cannot enter $test_path"; exit 1; }

compile --list- $option pascaline || exit 1
run --nolist $option --args="headertest1 headertest2 42 123.456 hi there" pascaline

# a missing listing means the run itself failed; do not let an empty
# comparison read as a pass
if [ ! -f pascaline.lst ]; then echo "*** FAIL (no listing)"; exit 1; fi
diffnolestrip pascaline.lst pascaline.cmp > pascaline.dif
wc -l pascaline.dif
if test -s pascaline.dif; then echo "*** FAIL"; exit 1
else echo "PASS"; fi
