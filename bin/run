#!/bin/bash
#
# The windows tools resolve child commands through the "Path" environment
# name (the windows capitalization); a posix shell exports "PATH". Provide
# both so the prebuilt tool set works when run from bash on a windows host
# (the amitk environment lookup is also being made case insensitive).
#
if [ "$OS" = "Windows_NT" ] && command -v cygpath >/dev/null 2>&1; then
    export Path="$(cygpath -pw "$PATH")"
fi
#
# Run a Pascal file in batch mode using GPC Pascal
#
# Runs a Pascal intermediate in batch mode.
#
# Execution:
#
# run <file> [--pmach|--cmach|--pint] [<inpfile>] <file>
#
# <file> is the filename without extention.
#
# The files are:
#
# <file>.p6  - The intermediate file.
# <file>.dat - The prd file to program.
# <file>.out - The prr file produced.
# <file>.inp - The input file to the program.
# <file>.lst - The output file from the program.
# <file>.p6o - The object deck for mach, if selected.
#
# The flags are one of:
#
# --pmach Generate mach code and run the result through pmach.
# --cmach Generate mach code and run the result through cmach.
# --pint  Generate mach code and run the result through pint (default).
# --windows Run a Windows cross-compiled executable (name.exe) under wine.
#

pint=0
pmach=0
cmach=0
package=0
pgen=1
windows=0
winexe=0
progfile=""
options=""
nolist="0"
userargs=""
argset=0
infile=""

#echo "run: command line: $@"

for param in "$@" 
do

    if [ "$param" = "--pint" ]; then
	
        pint=1
        pmach=0
        cmach=0
        package=0
        pgen=0

    elif [ "$param" = "--pmach" ]; then
	
        pmach=1
        pint=0
        cmach=0
        package=0
        pgen=0
        
    elif [ "$param" = "--cmach" ]; then
    
        cmach=1
        pint=0
        pmach=0
        package=0
        pgen=0

    elif [ "$param" = "--package" ]; then
    
        package=1
        pint=0
        pmach=0
        cmach=0
        pgen=0

    elif [ "$param" = "--pgen" ]; then
    
        pgen=1
        pint=0
        pmach=0
        cmach=0
        package=0

    elif [ "$param" = "--nolist" ]; then

        nolist=1

    elif [ "$param" = "--windows" ]; then

        # the program was cross compiled to a Windows executable; run it
        # through wine rather than directly. This is a run directive, not a
        # program argument, so it is recognized here and not collected into
        # the option string.
        windows=1

    elif [ "$param" = "--windowsexe" ]; then

        # run the interpreters from the windows host cell (through the
        # system's exe emulation) instead of the native bin ones. The
        # program under test is unchanged; this exercises the windows
        # built tools. A run directive, not a program argument.
        winexe=1

    elif [ "$param" = "--help" ]; then

		echo ""  
		echo "Run a Pascal file in batch mode using GPC Pascal"
		echo ""
		echo "Runs a Pascal intermediate in batch mode."
		echo ""
		echo "Execution:"
		echo ""
		echo "run <file> [--pmach|--cmach|--pint] <file>"
		echo ""
		echo "<file> is the filename without extention."
		echo ""
		echo "The files are:"
		echo ""
		echo "<file>.p6  - The intermediate file"
		echo "<file>.out - The prr file produced"
		echo "<file>.inp - The input file to the program"
		echo "<file>.lst - The output file from the program"
		echo "<file>.p6o - The object deck for mach, if selected"
		echo ""
		echo "The flags are one of:"
		echo ""
		echo "--pmach  Generate mach code and run the result through pmach."
		echo "--cmach  Generate mach code and run the result through cmach."
		echo "--pint   Generate mach code and run the result through pint."
        echo "--pgen   Run binary code {default)."
        echo "--windows Run a Windows cross-compiled executable under wine."
        echo "--windowsexe Run the interpreters from the windows host cell."
		echo "--nolist Do not output listing."
        echo "--args=<str> Replace the default program arguments (<file>.dat <out>)."
        echo "--in=<file>  Replace the default program input file (<file>.inp)."

		echo ""
		exit 0
		
    elif [ "${param:0:7}" = "--args=" ]; then

        # replace the default program arguments (<file>.dat <obase>.out) with
        # the given string. Lets a test drive programs whose arguments do not
        # follow the data file convention (e.g. an output filename, or free
        # form parameters). Quote the value to pass several.
        userargs="${param#--args=}"
        argset=1

    elif [ "${param:0:5}" = "--in=" ]; then

        # replace the default program input file (<file>.inp)
        infile="${param#--in=}"

    elif [ "${param:0:1}" = "-" ]; then

        # concatentate unrecognized options in option string
        options="$options $param"

	else
	
		progfile="$param"
		
    fi
    
done

if [ -z "$progfile" ]; then

	echo "*** Error: No run file specified"
	exit 1

fi

#
# Intermediates, the executable, products and temp files go to REGRESS_OUT when
# it is set, so several models can run in parallel into their own
# test_results/<model> directories. When unset they go next to the source as
# before. Input files (.inp, .dat) are always read from the source path.
#
if [ -n "$REGRESS_OUT" ]; then
    obase="$REGRESS_OUT/$(basename $progfile)"
    tmpd="$REGRESS_OUT/"
else
    obase="$progfile"
    tmpd=""
fi

# Only the interpreter backends consume the .p6 intermediate; pgen and package
# run a native binary (or the Windows .exe) and never open it, so requiring the
# .p6 there wrongly fails a native/windows run whose compile left no .p6.
if [ "$pgen" != "1" ] && [ "$package" != "1" ] && [ ! -f "$obase.p6" ]; then

	echo "$obase.p6 does not exist"
	exit 1

fi
if [ -z "$infile" ]; then infile="$progfile.inp"; fi
# -e, not -f: /dev/null is a valid input and not a regular file
if [ ! -e "$infile" ]; then

	echo "$infile does not exist"
	exit 1

fi

# program arguments: --args= replaces the default data file/output pair
if [ "$argset" = "1" ]; then prgargs="$userargs"
else prgargs="$progfile.dat $obase.out"; fi

# Interpreter selection: the windows tool set (--windowsexe explicitly, or
# REGRESS_WINDOWSEXE exported by the regression the same way as REGRESS_OUT)
# runs the interpreters from the windows host cell, found relative to this
# script, and the exe emulation runs them transparently. Otherwise they
# resolve from the path as before. cmach has no windows build and stays
# native.
if [ "$REGRESS_WINDOWSEXE" = "1" ]; then winexe=1; fi
if [ "$winexe" = "1" ]; then

    hostbin="$(cd "$(dirname "$0")/.." && pwd)/hosts/windows/x86/bit64/bin"
    pintcmd="$hostbin/pint.exe"
    pmachcmd="$hostbin/pmach.exe"

else

    pintcmd=pint
    pmachcmd=pmach

fi

# The run result is the exit status of the selected backend, captured before the
# trailing cleanup and listing can clobber $? -- otherwise a stray rm/cat failure
# is misreported as a compile/run failure (issue #252).
rc=0
if [ "$pmach" = "1" ]; then

	echo Running with pmach
    echo "o e+" > ${tmpd}temp
    cat ${tmpd}temp $obase.p6 > ${tmpd}temp2.p6
    $pintcmd ${tmpd}temp2.p6 $obase.p6o > ${tmpd}temp
    if [ "$argset" = "1" ]; then

        # explicit arguments: the deck runs as is, arguments on the command
        # line after the interpreter's output slot
        $pmachcmd $obase.p6o ${tmpd}temp3 $userargs $options < $infile &> $obase.lst
        rc=$? # capture the run result before cleanup clobbers it

    else

        cat $obase.p6o $progfile.dat > ${tmpd}temp.p6o
        $pmachcmd ${tmpd}temp.p6o $obase.out $options < $infile &> $obase.lst
        rc=$? # capture the run result before cleanup clobbers it

    fi
    rm ${tmpd}temp ${tmpd}temp2.p6

elif [ "$cmach" = "1" ]; then

	echo Running with cmach
    $pintcmd $obase.p6 $obase.p6o --machdeck > ${tmpd}temp
    cmach $obase.p6o $options $prgargs < $infile &> $obase.lst
    rc=$? # capture the run result before cleanup clobbers it
    rm ${tmpd}temp

elif [ "$package" = "1" ]; then

    echo Running with package
    ./$obase $options $prgargs < $infile &> $obase.lst
    rc=$?

elif [ "$pgen" = "1" ]; then

    if [ "$windows" = "1" ]; then

        # Windows cross target: the product is $obase.exe, run through wine.
        # WINEDEBUG=-all silences wine's own diagnostic channels so only the
        # program's output reaches the listing; the program's stdout and
        # stderr (including psystem runtime-error messages) still pass
        # through. An arm64 cross target needs no such handling: its product
        # is a native-named ELF that binfmt runs through qemu transparently.
        if command -v wine64 >/dev/null 2>&1; then wine=wine64; else wine=wine; fi
        echo "Running with pgen under wine"
        WINEDEBUG=-all $wine ./$obase.exe $prgargs $options \
            < $infile &> $obase.lst
        rc=$?
        # the Windows C runtime writes text streams with CRLF line endings;
        # normalize to LF so the listing matches the platform-neutral golden
        sed -i 's/\r$//' $obase.lst

    else

        echo Running with pgen
        # on a windows host the native product is $obase.exe; the C runtime
        # writes text streams with CRLF, so normalize the listing to LF the
        # same as the wine cross run above
        if [ -f "$obase.exe" ]; then

            ./$obase.exe $prgargs $options < $infile &> $obase.lst
            rc=$?
            sed -i 's/\r$//' $obase.lst

        else

            ./$obase $prgargs $options < $infile &> $obase.lst
            rc=$?

        fi

    fi

else

	echo Running with pint
    if [ "$argset" = "1" ]; then

        # explicit arguments: the deck runs as is, arguments on the command
        # line after the interpreter's output slot
        $pintcmd $obase.p6 ${tmpd}temp3 $userargs $options < $infile &> $obase.lst
        rc=$? # capture the run result before cleanup clobbers it

    else

        cat $obase.p6 $progfile.dat > ${tmpd}temp.p6
        $pintcmd ${tmpd}temp.p6 $obase.out $options < $infile &> $obase.lst
        rc=$? # capture the run result before cleanup clobbers it
        rm ${tmpd}temp.p6

    fi

fi

# The windows C runtime writes text streams with CRLF line endings; normalize
# the windows interpreters' listing to LF so it matches the platform-neutral
# golden (the pgen --windows branch does the same for windows products).
if [ "$winexe" = "1" ] && [ -f $obase.lst ]; then sed -i 's/\r$//' $obase.lst; fi

#
# Output listing if enabled
#
if [ "$nolist" = "0" ]; then

    cat $obase.lst

fi

exit $rc