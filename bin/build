#!/bin/bash
#
# General build script for Pascal-P6
#
# Form:
# 
# build [<options for make>] [<options for pc>]
#
# Note: if you want to give multiple options for make or pc, surround in quotes
# like:
#
# build "-Bi" "-r -d"
#
#
# Install a built program into bin. bin holds only binaries for the host we
# are running on: on a windows host the native build product is <prog>.exe,
# elsewhere the bare <prog>. The selection is by host, never by guessing
# between candidate files, so a stale bare-named leftover (e.g. a linux
# binary from an earlier use of the same tree) can never be installed.
# Cross compiled products (compwin) go only to the hosts tree, never bin.
# On windows both bin names (<name> and <name>.exe) are written so shell
# callers and native tool spawns (which require the .exe) both resolve.
# cygpath exists only on a windows msys/cygwin host, so it detects windows
# robustly.
#
function instprog {

   local src="$1"
   local dst="$2"

   if [ -d "$dst" ]; then dst="$dst/$(basename $1)"; fi
   if command -v cygpath >/dev/null 2>&1; then

      if [ ! -f "$1.exe" ]; then

         echo "*** Error: windows build product $1.exe missing"
         exit 1

      fi
      cp "$1.exe" "$dst"
      case "$dst" in *.exe) ;; *) cp "$1.exe" "$dst.exe" ;; esac

   else

      cp "$src" "$dst"

   fi

}

function compprog {

   echo ""
   echo "**********************************************************************"
   echo "Building $1..."
   echo "**********************************************************************"
   echo ""
   pc $1 $OPTIONS
   if [ $? -ne 0 ]; then

      echo "*** Error: compile failed"
      exit 1

   fi
   instprog $1 bin

}

#
# Cross compile a program for windows and install the executable in the
# windows host tree. All build products go to a scratch build path (-bp), not
# the source tree: a win64 build recompiles the program and its modules to
# win64 decks, and if those landed next to the native decks a later native
# build (pc without -r reuses an existing .p6 deck) would pick them up and
# pgen would reject the win64 option they carry. The build path is cleared for
# each program and the executable copied from it.
#
function compwin {

   echo ""
   echo "**********************************************************************"
   echo "Building $1 for windows..."
   echo "**********************************************************************"
   echo ""
   local bp="build/win64/exe"
   rm -rf "$bp"; mkdir -p "$bp"
   pc $1 --windows -bp="$bp" -r $OPTIONS
   if [ $? -ne 0 ]; then

      echo "*** Error: compile failed"
      exit 1

   fi
   cp "$bp/$(basename $1).exe" hosts/windows/x86/bit64/bin
   rm -rf "$bp"

}

OPTIONS=$2

#
# The graph flavor's "blonde" graphics archive is per-target: the linux
# build keeps it in source/graph itself, the windows build in
# source/graph/win64 (mirroring the hosts tree layout). Select the target's
# archive ahead of the flavor sources so the flavored interpreter builds
# (pintg, pmachg) link the right one. cygpath exists only on a windows
# msys/cygwin host, so it detects windows robustly.
#
if command -v cygpath >/dev/null 2>&1; then
   GRAPHMP="source/graph/win64;source/graph"
else
   GRAPHMP="source/graph"
fi

make clean
make $1
if [ $? -ne 0 ]; then

   echo "*** Error: make failed"
   exit 1

fi

#
# Build dummy decks to satisfy pc builds.
#
echo ""
echo "**********************************************************************"
echo "Building Dummy decks..."
echo "**********************************************************************"
echo ""
pc libs/source/services -pint -r
cp libs/source/services.p6 libs
pc libs/source/terminal -pint -r
cp libs/source/terminal.p6 libs
pc libs/source/graphics -pint -r
cp libs/source/graphics.p6 libs
pc libs/source/sound -pint -r
cp libs/source/sound.p6 libs
pc libs/source/network -pint -r
cp libs/source/network.p6 libs

#
# General library modules in Pascaline.
# These are compiled to objects and intermediates both because they can be used
# in executables and interpretation.
#
echo ""
echo "**********************************************************************"
echo "Building Strings..."
echo "**********************************************************************"
echo ""
pc libs/source/strings -r
cp libs/source/strings.o libs
pc libs/source/strings -windows -r
cp libs/source/strings.o hosts/windows/x86/bit64/libs
pc libs/source/strings -pint -r
cp libs/source/strings.p6 libs

echo ""
echo "**********************************************************************"
echo "Building Parse..."
echo "*******************************************s***************************"
echo ""
pc libs/source/parse -r
cp libs/source/parse.o libs
pc libs/source/parse -windows -r
cp libs/source/parse.o hosts/windows/x86/bit64/libs
pc libs/source/parse -pint -r
cp libs/source/parse.p6 libs

#
# Programs in Pascaline.
#
compprog pc/pc
compprog pc/hashtabr
compprog pc/hashtabs
compprog source/genobj
#
# dif is required by the test scripts: testprog compares the program listing
# against the golden through it, and a missing dif silently passes every test
# (an empty .dif is a pass).
#
compprog utils/dif
#
# parser and passym serve the vscode Pascaline extension's language server:
# parser produces on-save diagnostics, passym symbol information. Without
# them in bin the extension runs but reports nothing.
#
compprog source/parser
compprog utils/passym
#
# Test programs in libs/tests: build each as a native executable and place it
# in bin. pc detects each program's modules (graphics, sound, network,
# terminal, services) and links the matching libraries, so windowed, sound and
# network tests build the same way. Listed explicitly; add a new libs/tests
# program here to have it built and installed in bin.
#
compprog libs/tests/find_getpgm
compprog libs/tests/graphics_test
compprog libs/tests/management_test
compprog libs/tests/netprobe
compprog libs/tests/network_test
compprog libs/tests/services_test1
compprog libs/tests/services_test
compprog libs/tests/sndprobe
compprog libs/tests/sound_test
compprog libs/tests/strings_test
compprog libs/tests/terminal_test
compprog libs/tests/widget_test
#
# Graphical games in graph_games: build each as a native executable and place it
# in bin, same as the library tests. They use the graphics (and sound) modules;
# pc links the matching libraries.
#
compprog graph_games/backgammon
compprog graph_games/breakout
compprog graph_games/checkers
compprog graph_games/chess
compprog graph_games/conquest
compprog graph_games/defenders
compprog graph_games/pong
#
# Install game assets next to their binaries in bin. The asset-loading games
# (chess, conquest, backgammon) locate their data in their own program directory
# (getpgm), so the data must travel with the installed binary.
#
cp -r graph_games/chess_pieces bin/
cp graph_games/conquest_map.bmp graph_games/slide.wav graph_games/dice.wav bin/
#
# Save and restore an installed bin program across a rebuild, for the
# pgen/pcom matched set juggle below. On windows the .exe is the
# authoritative product -- it is what pc's native tool spawns resolve --
# so the save takes the .exe and the restore rewrites both bin names;
# elsewhere the bare name is the product. A bare-name-only juggle on
# windows leaves the .exe untouched, silently building pcom with the
# wrong code generator.
#
function saveprog {

   if command -v cygpath >/dev/null 2>&1; then
      cp "bin/$1.exe" "$2"
   else
      cp "bin/$1" "$2"
   fi

}

function restoreprog {

   cp "$2" "bin/$1"
   if command -v cygpath >/dev/null 2>&1; then
      cp "$2" "bin/$1.exe"
   fi

}

#
# pgen and pcom must be a matched set
#
saveprog pgen pgen.old
compprog source/pgen/amd64/pgen
instprog source/pgen/amd64/pgen bin/pgen_amd64
saveprog pgen pgen.new
restoreprog pgen pgen.old
compprog source/pcom
#
# Now regular
#
restoreprog pgen pgen.new
#
# The arm64 code generator is a cross tool: it runs on this host and generates
# aarch64 code. It keeps its own name in bin so it can sit beside the native
# code generator (the pc instruction file selects it for arm64_sysv targets).
#
echo ""
echo "**********************************************************************"
echo "Building source/pgen/arm64/pgen as pgen_arm64..."
echo "**********************************************************************"
echo ""
pc source/pgen/arm64/pgen -r $OPTIONS
if [ $? -ne 0 ]; then

   echo "*** Error: compile failed"
   exit 1

fi
instprog source/pgen/arm64/pgen bin/pgen_arm64
compprog source/pint
#
# pintt is the same source built with the terminal module flavor first on
# the module path (the instruction file appends the plain flavor after it).
# The plain interpreter is rebuilt afterward so source/pint matches its
# instruction file.
#
echo ""
echo "**********************************************************************"
echo "Building source/pint (terminal flavor) as pintt..."
echo "**********************************************************************"
echo ""
pc source/pint -mp=source/term -r $OPTIONS
if [ $? -ne 0 ]; then

   echo "*** Error: compile failed"
   exit 1

fi
instprog source/pint bin/pintt
#
# pintg is the graphics-hosted interpreter: the graph flavor links the
# "blonde" graphics archive (no automatic standard I/O window) and hosts
# the interpreted program's standard files in an openwin window.
#
echo ""
echo "**********************************************************************"
echo "Building source/pint (graphics flavor) as pintg..."
echo "**********************************************************************"
echo ""
pc source/pint "-mp=$GRAPHMP" -r $OPTIONS
if [ $? -ne 0 ]; then

   echo "*** Error: compile failed"
   exit 1

fi
instprog source/pint bin/pintg
pc source/pint -r $OPTIONS
if [ $? -ne 0 ]; then

   echo "*** Error: compile failed"
   exit 1

fi
instprog source/pint bin
compprog source/pmach
#
# pmacht and pmachg are the same source built with the terminal and graphics
# module flavors first on the module path, mirroring pintt and pintg. The plain
# interpreter is rebuilt afterward so source/pmach matches its instruction file.
#
echo ""
echo "**********************************************************************"
echo "Building source/pmach (terminal flavor) as pmacht..."
echo "**********************************************************************"
echo ""
pc source/pmach -mp=source/term -r $OPTIONS
if [ $? -ne 0 ]; then

   echo "*** Error: compile failed"
   exit 1

fi
instprog source/pmach bin/pmacht
echo ""
echo "**********************************************************************"
echo "Building source/pmach (graphics flavor) as pmachg..."
echo "**********************************************************************"
echo ""
pc source/pmach "-mp=$GRAPHMP" -r $OPTIONS
if [ $? -ne 0 ]; then

   echo "*** Error: compile failed"
   exit 1

fi
instprog source/pmach bin/pmachg
pc source/pmach -r $OPTIONS
if [ $? -ne 0 ]; then

   echo "*** Error: compile failed"
   exit 1

fi
instprog source/pmach bin

#
# cmacht is the terminal flavor of cmach, the same cmach.c built with -DTERMINAL
# so it hosts the terminal model too (mirroring pmacht). Built by the Makefile.
#
echo ""
echo "**********************************************************************"
echo "Building cmach terminal flavor as cmacht..."
echo "**********************************************************************"
echo ""
make bin/cmacht
if [ $? -ne 0 ]; then echo "*** Error: cmacht build failed"; exit 1; fi

#
# cmachg is the graphics flavor of cmach, the same cmach.c built with -DGRAPHICS.
# It hosts an Ami graphics window over the interpreted program (mirroring pmachg),
# linking the "blonde" NOSTDWIN graphics archive so the interpreter keeps its own
# console and vmhost opens the program's window. Built by the Makefile.
#
echo ""
echo "**********************************************************************"
echo "Building cmach graphics flavor as cmachg..."
echo "**********************************************************************"
echo ""
make bin/cmachg
if [ $? -ne 0 ]; then echo "*** Error: cmachg build failed"; exit 1; fi

#
# Windows host runtime libraries: (re)build the win64 psystem/services/etc.
# archives and install them in the windows host tree. These embed the Ami
# runtime sources (amitk services.c, libc/stdio.c), so they must be rebuilt
# here rather than trusted from the committed products -- otherwise a change to
# the Ami runtime (e.g. an amitk submodule advance) leaves the host tree libs,
# and every executable the compwin phase links against them, stale.
#
echo ""
echo "**********************************************************************"
echo "Building win64 host runtime libraries..."
echo "**********************************************************************"
echo ""
make win64
if [ $? -ne 0 ]; then

   echo "*** Error: win64 runtime library build failed"
   exit 1

fi

#
# Windows host executables: cross compile the toolchain programs to win64 and
# install them in the windows host tree, next to the win64 runtime libraries
# built just above. The windows pgen is the amd64 code generator, the same
# source as the native bin/pgen. The Ami flavored interpreters
# (pintt/pintg/pmacht/pmachg) await a win64 build of the petit-ami toolkit and
# are not yet cross built.
#
mkdir -p hosts/windows/x86/bit64/bin
compwin source/pcom
compwin source/pgen/amd64/pgen
compwin pc/pc
compwin source/genobj
compwin source/pint
compwin source/pmach
compwin utils/dif
