#!/bin/bash
#
# Test the historic Pascal-P4 port.
#
# Two stages, both through the standard compile/run flow: pcom (the P4
# compiler) translates p4/standardp.pas into P4 intermediate code, then pint
# (the P4 interpreter) runs that intermediate. The backend option passes
# through to both stages, and the listing is compared against p4/standardp.cmp
# (p4/standardpc.cmp for the C-based and native backends, which differ in
# real number formatting).
#
# testp4 [--pgen|--pint|--pmach|--cmach|--package]
#
option=$1
if [ -z "$option" ]; then option="--pgen"; fi
if [ -n "$REGRESS_OUT" ]; then tmpd="$REGRESS_OUT/"; else tmpd=""; fi
ob() { if [ -n "$REGRESS_OUT" ]; then echo "$REGRESS_OUT/$(basename "$1")"; else echo "$1"; fi; }

#
# Translate standardp.pas to P4 intermediate with the P4 compiler: the source
# arrives on input, the intermediate filename is the program argument.
#
compile --out="$REGRESS_OUT" --list- $option p4/pcom || exit 1
run --nolist $option --args="$(ob p4/standardp).p4" --in=p4/standardp.pas p4/pcom

#
# Run the intermediate through the P4 interpreter and compare.
#
compile --out="$REGRESS_OUT" --list- $option p4/pint || exit 1
run --nolist $option --args="$(ob p4/standardp).p4 ${tmpd}temp4" --in=/dev/null p4/pint

# a missing listing means the run itself failed; do not let an empty
# comparison read as a pass
if [ ! -f $(ob p4/pint).lst ]; then echo "*** FAIL (no listing)"; exit 1; fi
strip $(ob p4/pint).lst ${tmpd}tmp1
if [ "$option" = "--cmach" ] || [ "$option" = "--package" ] || [ "$option" = "--pgen" ]; then
    strip p4/standardpc.cmp ${tmpd}tmp2
else
    strip p4/standardp.cmp ${tmpd}tmp2
fi
diff -B ${tmpd}tmp1 ${tmpd}tmp2 > $(ob p4/standardp).dif
rm -f ${tmpd}tmp1 ${tmpd}tmp2
ls -l $(ob p4/standardp).dif | grep ".dif"
if test -s $(ob p4/standardp).dif; then echo "*** FAIL"; exit 1
else echo "PASS"; fi
