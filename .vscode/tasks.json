{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Pascal",
            "type": "shell",
            "command": "pc ${fileBasenameNoExtension}",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "${workspaceFolder}/bin:${env:PATH}"
                }
            },
            "windows": {
                "options": {
                    "cwd": "${fileDirname}",
                    "env": {
                        "PASCALP6": "${workspaceFolder}",
                        "PATH": "${workspaceFolder}\\bin;C:\\msys64\\mingw64\\bin;C:\\msys64\\usr\\bin;${env:PATH}"
                    }
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Build C (gcc)",
            "type": "shell",
            "command": "gcc -g3 -O0 ${file} -o ${fileDirname}/${fileBasenameNoExtension}",
            "options": {
                "cwd": "${fileDirname}"
            },
            "windows": {
                "options": {
                    "cwd": "${fileDirname}",
                    "env": {
                        "PATH": "C:\\msys64\\mingw64\\bin;C:\\msys64\\usr\\bin;${env:PATH}"
                    }
                }
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build and Run",
            "type": "shell",
            "command": "pc ${fileBasenameNoExtension} && pint ${fileBasenameNoExtension} ${fileBasenameNoExtension}",
            "group": "test",
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "${workspaceFolder}/bin:${env:PATH}"
                }
            },
            "windows": {
                "command": "pc ${fileBasenameNoExtension}; if ($?) { & .\\${fileBasenameNoExtension}.exe }",
                "options": {
                    "cwd": "${fileDirname}",
                    "env": {
                        "PASCALP6": "${workspaceFolder}",
                        "PATH": "${workspaceFolder}\\bin;C:\\msys64\\mingw64\\bin;C:\\msys64\\usr\\bin;${env:PATH}"
                    }
                }
            },
            "problemMatcher": []
        }
    ]
}
