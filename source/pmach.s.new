#    166:    338: !
#    166:    339: ! Program pmach
#    166:    340: !
#    166:    341: b       p       pmach
        .globl  pmach
        .type   pmach, @function
pmach:
        .cfi_startproc
# Align stack
        pushq   %rax
        .cfi_adjust_cfa_offset 8
# Set up default files
        movb    $inputfn,globals_start+inputoff(%rip)
        movb    $outputfn,globals_start+outputoff(%rip)
        movb    $prdfn,globals_start+prdoff(%rip)
        movb    $prrfn,globals_start+prroff(%rip)
        movb    $errorfn,globals_start+erroroff(%rip)
        movb    $listfn,globals_start+listoff(%rip)
        movb    $commandfn,globals_start+commandoff(%rip)
# Call startup code
        call    1f
        popq    %rax
        .cfi_adjust_cfa_offset -8
        sub     %rax,%rax
        ret
        .cfi_endproc
1:
#    166:    342:         sfr     l pmach.6               ! Set function result
#    166:    343: l pmach.6=0
pmach.6 = 0
#    166:    344:         cup     l pmach.3 0              ! Call user procedure
# assigning:     166:    344:  12: cup  0 rs: [] ~rf: []
# assigning~:    166:    344:  12: cup  0 rs: [] ~rf: []
#    expr:
#     166:    344:  12: cup  0 rs: []
#  call start:
#     166:    342: 245: sfr  0 rs: []
# generating:     166:    344:  12: cup  0 rs: []
# generating:     166:    342: 245: sfr  0 rs: []
        movq    %rsp,%rax               # copy stack pointer
        subq    $pmach.6,%rax           # set new stack depth
1:              
        cmpq    %rax,%rsp               # check done
        jbe     2f                      # skip if below stack
        pushq   $0                      # clear stack
        jmp     1b                      # loop
2:              
# generating~:    166:    342: 245: sfr  0 rs: []
        call    pmach.3                 # call user procedure
# generating~:    166:    344:  12: cup  0 rs: []
#    166:    345:         ret                             ! Return code strip
        ret      
