    Type: subrange

    data location and instruction counter

lcs (variable)
    Type: subrange

dp (variable)
    Type: boolean


list (variable)
    Type: boolean

    declaration part

dolineinfo (variable)
    Type: boolean

     -- l: source program listing

prcode (variable)
    Type: boolean

     -- z: Output line information on listing

prtables (variable)
    Type: boolean

     -- c: print symbolic code

chkvar (variable)
    Type: boolean

     -- t: displaying ident and struct tables

debug (variable)
    Type: boolean

     -- v: check variant records

chkref (variable)
    Type: boolean

     -- d: Debug checks

chkudtc (variable)
    Type: boolean

     -- r: Reference checks

chkudtf (variable)
    Type: boolean

iso7185 (variable)
    Type: boolean

     -- u: Check undefined tagfields, candidate
                                             and final

dodmplex (variable)
    Type: boolean

     -- s: restrict to iso7185 language

doprtryc (variable)
    Type: boolean

     -- x: dump lexical

doprtlab (variable)
    Type: boolean

     -- z: dump recycling tracker counts

dodmpdsp (variable)
    Type: boolean

     -- b: print labels

chkvbk (variable)
    Type: boolean

     -- y: dump the display

experr (variable)
    Type: boolean

     -- i: check VAR block violations

