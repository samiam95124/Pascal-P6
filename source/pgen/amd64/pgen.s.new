        .bss
#
# Globals section
#
globals_start:
        .zero 137

#
# DWARF debug info
#
        .section .debug_info,"",@progbits
.Ldw_info_start:
        .long   .Ldw_info_end - .Ldw_info_hdr # unit length
.Ldw_info_hdr:
        .short  4  # DWARF version
        .long   .Ldw_abbrev_start  # debug_abbrev offset
        .byte   8 # address size
        .uleb128 1 # DW_TAG_compile_unit
        .long   .Ldw5
        .short  2 # language
        .long   .Ldw6
        .quad   pgen # DW_AT_low_pc
        .quad   .Lfnend_36 # DW_AT_high_pc
        .long   .Ldw_line_start # DW_AT_stmt_list
.Ldw1:
        .uleb128 2 # DW_TAG_base_type
        .long   .Ldw7
        .byte   5 # DW_ATE_signed
        .byte   8 # byte_size
.Ldw2:
        .uleb128 2 # DW_TAG_base_type
        .long   .Ldw8
        .byte   2 # DW_ATE_boolean
        .byte   1 # byte_size
.Ldw3:
        .uleb128 2 # DW_TAG_base_type
        .long   .Ldw9
        .byte   8 # DW_ATE_unsigned_char
        .byte   1 # byte_size
.Ldw4:
        .uleb128 2 # DW_TAG_base_type
        .long   .Ldw10
        .byte   4 # DW_ATE_float
        .byte   8 # byte_size
        .uleb128 18 # DW_TAG_subprogram
        .long   .Ldw6
        .uleb128 1 # frame_base length
        .byte   86 # DW_OP_reg6
        .quad   pgen # DW_AT_low_pc
        .quad   .Lfnend_36 # DW_AT_high_pc
        .uleb128 3 # DW_TAG_subprogram
        .long   .Ldw11
        .uleb128 1 # frame_base length
        .byte   86 # DW_OP_reg6
        .quad   pgen.assemble$p # DW_AT_low_pc
        .quad   .Lfnend_35 # DW_AT_high_pc
.Ldw13:
        .uleb128 10 # DW_TAG_structure_type
        .long   .Ldw14
        .uleb128 0 # byte_size
.Ldw15:
        .uleb128 21 # DW_TAG_pointer_type (void, fwd ref)
        .byte   8 # byte_size
        .uleb128 11 # DW_TAG_member
        .long   .Ldw16
        .long   .Ldw15 - .Ldw_info_start
        .uleb128 0 # data_member_location
.Ldw17:
        .uleb128 21 # DW_TAG_pointer_type (void, fwd ref)
        .byte   8 # byte_size
        .uleb128 11 # DW_TAG_member
        .long   .Ldw18
        .long   .Ldw17 - .Ldw_info_start
        .uleb128 8 # data_member_location
.Ldw19:
        .uleb128 21 # DW_TAG_pointer_type (void, fwd ref)
        .byte   8 # byte_size
        .uleb128 11 # DW_TAG_member
        .long   .Ldw20
        .long   .Ldw19 - .Ldw_info_start
        .uleb128 16 # data_member_location
.Ldw22:
        .uleb128 8 # DW_TAG_array_type
        .long   .Ldw3 - .Ldw_info_start
.Ldw23:
        .uleb128 9 # DW_TAG_subrange_type
        .long   .Ldw1 - .Ldw_info_start
        .sleb128 0 # lower_bound
        .sleb128 0 # upper_bound
        .byte   0  # end array children
.Ldw21:
        .uleb128 7 # DW_TAG_pointer_type
        .long   .Ldw22 - .Ldw_info_start
        .byte   8 # byte_size
        .uleb128 11 # DW_TAG_member
        .long   .Ldw24
        .long   .Ldw21 - .Ldw_info_start
        .uleb128 24 # data_member_location
.Ldw25:
        .uleb128 21 # DW_TAG_pointer_type (void, fwd ref)
        .byte   8 # byte_size
        .uleb128 11 # DW_TAG_member
        .long   .Ldw26
        .long   .Ldw25 - .Ldw_info_start
        .uleb128 32 # data_member_location
.Ldw27:
        .uleb128 21 # DW_TAG_pointer_type (void, fwd ref)
        .byte   8 # byte_size
        .uleb128 11 # DW_TAG_member
        .long   .Ldw28
        .long   .Ldw27 - .Ldw_info_start
        .uleb128 40 # data_member_location
