!
! Module independent
!
b       m       independent
        sfr     l independent.6         ! Set function result
l independent.6=0
        cup     l independent.3 0        ! Call user procedure
        cal     l independent.5         ! Call initializer code strip
        sfr     l independent.6         ! Set function result
        cup     l independent.4 0        ! Call user procedure
        ret                             ! Return code strip
!
