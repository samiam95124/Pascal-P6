:188
:189
:190
:191
:192
:193
:194
:195
:196
:197
:198
!     { number of routine to execute}             routine: integer;
:199
!     { address of parameters bottom/result } var params:  integer
:200
! );
:201
!
! const 
b r ExecuteExternal@p_i_i
s       routine p -64 i
s       params p -56 i
