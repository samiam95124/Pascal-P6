!       char                  8         8
!       boolean               8         8
!       set                   256       256
!       pointers              16        32        64
!       marks                 16        32        64 (bytes)
!       File logical number   8         8         8
!
!       Both endian types are supported. There is no alignment needed, but you
!       may wish to use alignment to tune the runtime speed.
