#!/bin/bash
################################################################################
#
# Configure script for Pascal-p6
#
# Sets up the complete Pascal-p6 project: determines the host, architecture
# and bit length this machine presents, checks the external tools and
# libraries the build needs and installs the missing ones with apt-get or
# dnf, whichever the host has (building the
# static ALSA and fluidsynth archives that no distribution carries), then
# restores the working bin and libs directories from the matching directory
# of the hosts tree. The hostinstall make target performs the reverse
# snapshot.
#
################################################################################

#
# Check command exists
#
# Uses the bash "command" built in.
#
function checkexists {

    command -v $1 >/dev/null
    rc=$?
    if [[ $rc != 0 ]] ; then

        echo "*** No $1 was found"

    fi

}

#
# The external tools and libraries the build needs, beyond the base shell
# utilities. Each entry is:
#
#     <check>;<target>;<deb package>;<rpm package>
#
# where <check> is one of:
#
#     cmd    the target is a program that must be on the path
#     pkg    the target is a pkg-config module, which is how a library's
#            development package (its headers and link libraries) announces
#            itself
#     hdr    the target is a header file that must be present, for a library
#            that installs no pkg-config file
#
# and the packages are the ones that supply it: the Debian/Ubuntu package,
# installed with apt-get, and the RHEL/Rocky/Fedora package, installed with
# dnf. On RHEL and Rocky some of these are in the CRB and EPEL repositories
# (libXdmcp-devel and fluidsynth-devel), which installdeps enables if the
# first install fails.
#
# The libraries are the ones the Ami models bind to, and that pc names on its
# link lines: OpenSSL for network, ALSA and fluidsynth (with glib and pcre2)
# for sound, X11 with XTest for graphics, and FreeType with FontConfig for
# its fonts. The rest are the transitive closure of those, listed so that a
# static build (pc -static, see --static below) finds every archive; the
# default dynamic link needs only the top ones.
#
# Only pcre2 is named. glib 2.73 and on use pcre2, and the earlier glib of
# Ubuntu 20.04 links its own pcre when glib is linked as a shared library,
# so pcre (pcre1, which Ubuntu 26.04 no longer carries) is never needed.
#
# OpenSSL links statically into every program (#661), so its static closure
# is needed too: zstd (with zlib, above) for OpenSSL 3, and jitterentropy
# where OpenSSL was built with it, which is checked separately below since
# older releases do not carry that package.
#
# The development packages for ALSA and fluidsynth supply the headers and
# shared objects only. A static build also needs tools/staticdeps/build.sh,
# which builds the archives; --static runs it.
#
DEPS="
cmd;gcc;build-essential;gcc
cmd;g++;build-essential;gcc-c++
cmd;make;build-essential;make
cmd;ar;binutils;binutils
cmd;pkg-config;pkg-config;pkgconf-pkg-config
cmd;zip;zip;zip
pkg;openssl;libssl-dev;openssl-devel
pkg;alsa;libasound2-dev;alsa-lib-devel
pkg;fluidsynth;libfluidsynth-dev;fluidsynth-devel
pkg;glib-2.0;libglib2.0-dev;glib2-devel
pkg;libpcre2-8;libpcre2-dev;pcre2-devel
pkg;x11;libx11-dev;libX11-devel
pkg;xext;libxext-dev;libXext-devel
pkg;xtst;libxtst-dev;libXtst-devel
pkg;xi;libxi-dev;libXi-devel
pkg;xfixes;libxfixes-dev;libXfixes-devel
pkg;xcb;libxcb1-dev;libxcb-devel
pkg;xau;libxau-dev;libXau-devel
pkg;xdmcp;libxdmcp-dev;libXdmcp-devel
pkg;freetype2;libfreetype-dev;freetype-devel
pkg;fontconfig;libfontconfig1-dev;fontconfig-devel
pkg;libpng;libpng-dev;libpng-devel
pkg;zlib;zlib1g-dev;zlib-devel
pkg;libzstd;libzstd-dev;libzstd-devel
pkg;expat;libexpat1-dev;expat-devel
pkg;uuid;uuid-dev;libuuid-devel
pkg;libbrotlidec;libbrotli-dev;brotli-devel
hdr;/usr/include/bzlib.h;libbz2-dev;bzip2-devel
"

#
# The tools tools/staticdeps/build.sh needs to build the static ALSA and
# fluidsynth archives: cmake configures fluidsynth, wget fetches both
# sources, patch applies the ALSA static patch and bzip2 unpacks the ALSA
# tarball. The compiler and make it also needs are in DEPS above.
#
SDEPS="
cmd;cmake;cmake;cmake
cmd;wget;wget;wget
cmd;patch;patch;patch
cmd;bzip2;bzip2;bzip2
"

#
# Find the dependencies of the given class in the given table that are not
# present, and leave the packages that supply them in "missing". The class
# is "cmd" for the programs and "lib" for the libraries, which are checked
# in that order because the library checks run through pkg-config, itself
# one of the programs. The package named is the one in the format of the
# host's package manager.
#
function checkdeps {

    local ent kind target debpkg rpmpkg package

    missing=
    for ent in $2 ; do

        IFS=';' read -r kind target debpkg rpmpkg <<< "$ent"
        if [ "$pkgfmt" = "rpm" ] ; then

            package=$rpmpkg

        else

            package=$debpkg

        fi

        case $kind in

            cmd) if [ "$1" != "cmd" ] ; then continue ; fi
                 if command -v $target >/dev/null ; then continue ; fi ;;
            pkg) if [ "$1" != "lib" ] ; then continue ; fi
                 if pkg-config --exists $target 2>/dev/null ; then continue ; fi ;;
            hdr) if [ "$1" != "lib" ] ; then continue ; fi
                 if [ -f "$target" ] ; then continue ; fi ;;

        esac

        echo "*** Missing $target, from package $package"

        #
        # One package can supply several targets (build-essential supplies
        # gcc, g++ and make), so name it once.
        #
        case " $missing " in

            *" $package "*) ;;
            *)              missing="$missing $package" ;;

        esac

    done

}

#
# Install the packages left in "missing" by checkdeps, with the host's
# package manager. A failed install is most often, with apt-get, stale
# package lists, and with dnf on RHEL and Rocky, a package in the CRB or
# EPEL repository, which a fresh install has not enabled. So that is put
# right and the install tried once more before giving up.
#
function installdeps {

    if [ -z "$missing" ] ; then

        return 0

    fi

    if [ -z "$pkgmgr" ] || [ -n "$noinstall" ] ; then

        echo "Install these with: $sudo ${pkgmgr:-apt-get} install -y$missing"
        if [ "$pkgmgr" = "dnf" ] ; then

            echo "On RHEL and Rocky, some are in the CRB and EPEL repositories:"
            echo "    $sudo dnf config-manager --set-enabled crb"
            echo "    $sudo dnf install -y epel-release"

        fi
        return 1

    fi

    echo "Installing:$missing"
    if $sudo $pkgmgr install -y $missing ; then

        return 0

    fi

    if [ "$pkgmgr" = "dnf" ] ; then

        echo "Install failed, enabling the CRB and EPEL repositories and retrying"
        $sudo dnf config-manager --set-enabled crb && \
            $sudo dnf install -y epel-release && \
            $sudo dnf install -y $missing

    else

        echo "Install failed, updating package lists and retrying"
        $sudo apt-get update && $sudo apt-get install -y $missing

    fi

}

#
# Check that a static archive for the given library is on the linker's
# search path, by linking a program that names it statically. Used by
# --static, where a library present only as a shared object does not serve.
#
function checkstatic {

    local tmp

    tmp=`mktemp -d`
    echo 'int main(void) { return 0; }' > $tmp/probe.c
    gcc -static -o $tmp/probe $tmp/probe.c -l$1 > /dev/null 2>&1
    rc=$?
    rm -rf $tmp

}

#
# Determine the running host, architecture and bit length, matching the
# makefile's detection.
#
if [ -n "$OS" ] && [ "$OS" = "Windows_NT" ] ; then

    host="windows"

else

    case `uname` in

        Linux)  host="linux" ;;
        Darwin) host="mac" ;;
        *BSD*)  host="bsd" ;;
        *)      host="linux" ;;

    esac

fi

case `uname -m` in

    x86_64|amd64)        arch="x86";   bits="64" ;;
    i386|i486|i586|i686) arch="x86";   bits="32" ;;
    aarch64)             arch="arm";   bits="64" ;;
    armv*)               arch="arm";   bits="32" ;;
    riscv64)             arch="riscv"; bits="64" ;;
    riscv32)             arch="riscv"; bits="32" ;;
    *)                   arch="x86";   bits="64" ;;

esac

#
# Check user arguments. These are read before anything is checked or
# installed, so --help and --no-install take effect first.
#
for var in "$@"
do

    if [ $var = "--help" ]
    then

        echo "Configure host for Pascal-p6"
        echo
        echo "--32:         Select 32 bit target"
        echo "--64:         Select 64 bit target"
        echo "--no-install: Only report the missing tools, libraries and"
        echo "              static archives, do not install or build them"
        echo "--static:     Also provide the static ALSA and fluidsynth"
        echo "              archives a static build (pc -static) links,"
        echo "              building them from source if missing"
        echo
        echo "Exit status is 1 if anything is missing, could not be installed"
        echo "or could not be built, so with --no-install it reports the state"
        echo "of the host without changing it."
        echo
        exit 0

    elif [ $var = "--32" ]
    then

        bits="32"

    elif [ $var = "--64" ]
    then

        bits="64"

    elif [ $var = "--no-install" ]
    then

        noinstall="1"

    elif [ $var = "--static" ]
    then

        static="1"

    fi

done

#
# Determine if needed programs exist. The only fatal one is grep, because we
# need that to run this script. The rest will impact the running of various
# test and build scripts.
#
checkexists grep
if [[ $rc != 0 ]] ; then

    exit 1

fi

checkexists diff
checkexists sed
checkexists rm
checkexists cp
checkexists mv
checkexists ls

#
# Check the external tools and libraries, and install what is missing.
# Installing needs apt-get (Debian, Ubuntu) or dnf (RHEL, Rocky, Fedora),
# and the package names follow the one found, so on a host with neither the
# check reports the Debian names and the install is left to hand. Root
# installs directly, anyone else through sudo.
#
pkgmgr=
pkgfmt="deb"
if command -v apt-get >/dev/null ; then

    pkgmgr="apt-get"

elif command -v dnf >/dev/null ; then

    pkgmgr="dnf"
    pkgfmt="rpm"

fi
if [ "`id -u`" != "0" ] ; then

    sudo="sudo"
    if ! command -v sudo >/dev/null ; then

        echo "*** Not root and no sudo: nothing can be installed"
        noinstall="1"

    fi

fi

#
# Anything reported but not fatal on the spot (a dependency that could not
# be installed, a build that failed) sets this, and the script exits 1 at
# the end so a caller can rely on the status.
#
softfail=

checkdeps cmd "$DEPS"
installdeps || softfail="1"

#
# The library checks ask pkg-config, so they only mean anything once it is
# there.
#
if command -v pkg-config >/dev/null ; then

    checkdeps lib "$DEPS"
    installdeps || softfail="1"

else

    echo "*** No pkg-config: the build libraries cannot be checked"
    softfail="1"

fi

#
# OpenSSL is linked statically (#661). Where OpenSSL was built with the
# jitterentropy source (OpenSSL 3 on the newer releases), its static
# closure names libjitterentropy.a, which only libjitterentropy3-dev
# (jitterentropy-devel on RHEL and Rocky) supplies. Older releases neither need nor carry that package, so it is
# asked for only when pkg-config names it.
#
if [ "$host" = "linux" ] && command -v pkg-config >/dev/null && \
   pkg-config --static --libs libcrypto 2>/dev/null | grep -q jitterentropy ; then

    if [ ! -f "$(gcc -print-file-name=libjitterentropy.a 2>/dev/null)" ] ; then

        jitterpkg="libjitterentropy3-dev"
        if [ "$pkgfmt" = "rpm" ] ; then

            jitterpkg="jitterentropy-devel"

        fi
        echo "*** Missing libjitterentropy.a, from package $jitterpkg"
        missing=" $jitterpkg"
        installdeps || softfail="1"

    fi

fi

#
# The LLVM target (pc -llvm) writes textual LLVM IR with opaque pointers,
# which clang 15 and later read; an older clang rejects every module it is
# handed ("expected type"). clang is optional: with none on the path the
# LLVM target is unavailable, bin/build and regress leave it out, and
# nothing is asked. With one that is too old the build would fail partway
# through instead, so the newest clang the host has installed, or failing
# that the newest its package lists carry, is offered as an upgrade:
# installed if need be, and made the default clang through
# update-alternatives (bin/pc.ins names the driver "clang"). Declining ends
# configure, since the tree does not build with that clang on the path.
#
CLANGMIN=15

# Major version of the given clang command, empty if it does not run.
function clangmajor {

    $1 --version 2>/dev/null | sed -n '1s/.*version \([0-9][0-9]*\)\..*/\1/p'

}

if [ "$host" = "linux" ] && command -v clang >/dev/null ; then

    clangver=`clangmajor clang`
    if [ -z "$clangver" ] || [ "$clangver" -lt $CLANGMIN ] ; then

        echo "*** clang $clangver is too old for the LLVM target (pc -llvm),"
        echo "    which needs clang $CLANGMIN or later"

        # The newest versioned clang on the path, else the newest apt carries
        newclang=
        newinst=
        for c in `compgen -c clang- | grep -E '^clang-[0-9]+$' | sort -uVr` ; do

            if [ ${c#clang-} -ge $CLANGMIN ] ; then

                newclang=$c
                newinst="1"
                break

            fi

        done
        if [ -z "$newclang" ] && [ "$pkgmgr" = "apt-get" ] ; then

            newclang=`apt-cache search --names-only '^clang-[0-9]+$' 2>/dev/null | \
                      cut -d' ' -f1 | sort -Vr | head -1`
            if [ -n "$newclang" ] && [ ${newclang#clang-} -lt $CLANGMIN ] ; then

                newclang=

            fi

        fi
        if [ -z "$newclang" ] ; then

            echo "*** No clang $CLANGMIN or later is available to upgrade to"
            exit 1

        fi
        clanglink=`command -v clang`
        clangprio=${newclang#clang-}0
        if [ -n "$noinstall" ] ; then

            echo "Upgrade with:"
            if [ -z "$newinst" ] ; then

                echo "    $sudo $pkgmgr install -y $newclang"

            fi
            echo "    $sudo update-alternatives --install $clanglink clang" \
                 "/usr/bin/$newclang $clangprio"
            softfail="1"

        else

            echo -n "Make $newclang the default clang? [y/n] "
            read -r answer
            case $answer in

                [yY]*) ;;
                *)     echo "*** Configure aborted: the LLVM target needs" \
                            "clang $CLANGMIN or later"
                       exit 1 ;;

            esac
            if [ -z "$newinst" ] ; then

                missing=" $newclang"
                if ! installdeps ; then

                    echo "*** Unable to install $newclang"
                    exit 1

                fi

            fi
            $sudo update-alternatives --install $clanglink clang \
                `command -v $newclang` $clangprio
            if [[ $? != 0 ]] ; then

                echo "*** Unable to make $newclang the default clang"
                exit 1

            fi
            clangver=`clangmajor clang`
            if [ -z "$clangver" ] || [ "$clangver" -lt $CLANGMIN ] ; then

                echo "*** clang is still version $clangver after the upgrade"
                exit 1

            fi
            echo "clang is now version $clangver"

        fi

    fi

elif [ "$host" = "linux" ] ; then

    echo "No clang: the LLVM target (pc -llvm) will not be available"

fi

#
# The static ALSA and fluidsynth archives a static build of the sound model
# links (pc -static; the default Linux link is dynamic and uses the shared
# objects). No distribution carries these -- libasound2-dev and
# libfluidsynth-dev install the headers and the shared objects only -- so
# they are built from source by tools/staticdeps/build.sh, which installs
# them in /usr/local/lib. Without them a static link of cmach, or of any
# program using the sound module, fails with "cannot find -lasound" or
# "cannot find -lfluidsynth".
#
# The build fetches and compiles both projects and takes some minutes, and
# its ALSA patch tracks a particular alsa-lib release, so it is run only on
# request (--static) and only when an archive is actually missing.
#
if [ -n "$static" ] && [ "$host" = "linux" ] && command -v gcc >/dev/null ; then

    staticmiss=
    checkstatic asound
    if [[ $rc != 0 ]] ; then

        staticmiss="$staticmiss libasound.a"

    fi
    checkstatic fluidsynth
    if [[ $rc != 0 ]] ; then

        staticmiss="$staticmiss libfluidsynth.a"

    fi

    if [ -n "$staticmiss" ] ; then

        echo "*** Missing static archives:$staticmiss"

        if [ -n "$noinstall" ] ; then

            echo "Build these with: tools/staticdeps/build.sh"

        else

            checkdeps cmd "$SDEPS"
            installdeps || softfail="1"
            echo "Building static ALSA and fluidsynth from source. This takes"
            echo "some minutes and fetches both sources from the network."
            ./tools/staticdeps/build.sh
            if [[ $? != 0 ]] ; then

                echo "*** Unable to build the static archives"
                softfail="1"

            fi

        fi

    fi

fi

#
# flip is built from source here rather than installed, since not every
# distribution carries it. It needs the compiler checked above.
#
checkexists flip > /dev/null

if [[ $rc != 0 ]] ; then

    echo -n "flip does not exist"
    echo $PATH | grep -q "$PWD/bin" || echo -n ", has PATH been set up?"
    echo
    echo "attempting to make it"
    gcc -o ./bin/flip ./source/flip.c
    checkexists flip > /dev/null
    flip=$rc
    if [[ $rc != 0 ]] ; then

        echo "*** Unable to make flip"
        softfail="1"

    fi

fi

#
# Restore the working binaries and libraries from the hosts tree.
#
# On glibc hosts the cell holds one leaf per minimum glibc requirement
# (glibc<major>.<minor>); tools/hostleaf.sh picks the newest leaf not above
# the running glibc, since a product built against an older glibc runs on
# every newer one and on no older one. A cell without leaves is used flat.
#
hostcell="hosts/$host/$arch/bit$bits"
hostcell=$(tools/hostleaf.sh --select "$hostcell")
if [[ $? != 0 ]] ; then exit 1 ; fi
echo "Set up for $host/$arch/bit$bits from $hostcell"

if [ ! -d "$hostcell/bin" ] ; then

    echo "*** No hosts tree entry for $hostcell"
    exit 1

fi

cp $hostcell/bin/* bin 2>/dev/null
cp -r $hostcell/libs/* libs 2>/dev/null
rm -f bin/.gitkeep libs/.gitkeep

#
# The OpenSSL link for pc (#661): the static archives with the dependency
# set this host's OpenSSL needs, found by tools/openssllink.sh. It depends on
# the host, not the leaf, so it is written here rather than restored. If the
# static link cannot be made, the script warns and gives the shared
# libraries, and programs then depend on this host's OpenSSL soname.
#
if [ "$host" = "linux" ] ; then

    tools/openssllink.sh > libs/openssl.link
    echo "OpenSSL links as: $(cat libs/openssl.link)"

fi

#
# The asset-loading games (chess, conquest, backgammon) find their data in
# their own program directory, so it goes next to the binaries in bin, as
# bin/build installs it.
#
cp -r graph_games/chess_pieces bin/
cp graph_games/conquest_map.bmp graph_games/slide.wav graph_games/dice.wav bin/

#
# The makefile takes the project root from PASCALP6, and setpath is what
# sets it, along with putting bin on the path. Sourcing setpath cannot be
# done from here, since a program cannot set the environment of the shell
# that called it, so this only warns: with PASCALP6 unset the makefile's
# paths become /source, /build and so on, and the build fails without
# naming the cause.
#
if [ -z "$PASCALP6" ] ; then

    echo
    echo "*** PASCALP6 is not set. Run \". ./setpath\" before make"
    echo

fi

if [ -n "$softfail" ] ; then

    echo "*** Configure completed with errors"
    exit 1

fi
echo "Configure completed!"
